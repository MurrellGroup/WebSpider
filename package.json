{
  "name": "webspider-fabric",
  "version": "0.6.21",
  "private": true,
  "description": "Distributed, persistent LLM-agent orchestration control plane",
  "type": "module",
  "bin": {
    "webspider": "./bin/webspider.js"
  },
  "scripts": {
    "start": "node ./bin/webspider.js up",
    "build:molstar": "node ./scripts/build-molstar-preview.mjs",
    "build:installer": "sh ./scripts/build-self-installer.sh",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "doctor": "node ./bin/webspider.js doctor"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "esbuild": "0.25.9",
    "molstar": "5.4.2"
  }
}
